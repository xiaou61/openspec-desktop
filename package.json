{
  "name": "openspec-desktop",
  "version": "0.1.0",
  "description": "Local, read-only OpenSpec project progress monitor",
  "private": true,
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "postinstall": "node scripts/install-electron.mjs",
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:watcher": "vitest run src/main/watcher",
    "test:ipc": "vitest run src/main/ipc src/preload",
    "test:renderer": "vitest run src/renderer",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:electron": "pnpm build && node scripts/run-electron-e2e.mjs",
    "check:renderer-boundary": "node scripts/check-renderer-boundary.mjs",
    "build": "pnpm typecheck && electron-vite build && pnpm check:renderer-boundary",
    "start": "electron-vite preview",
    "build:unpacked": "pnpm build && electron-builder --dir",
    "package:nsis": "pnpm build && electron-builder --win nsis",
    "package:portable": "pnpm build && electron-builder --win portable",
    "package:win": "pnpm build && electron-builder --win nsis portable",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "build": {
    "appId": "local.openspec.desktop",
    "productName": "OpenSpec Desktop",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "OpenSpec-Desktop-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "OpenSpec-Desktop-${version}-Portable.${ext}"
    }
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-query": "^5.101.4",
    "chokidar": "^5.0.0",
    "diff": "^9.0.0",
    "lucide-react": "^1.28.0",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^43.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.2.4",
    "vitest": "^4.1.10"
  }
}
